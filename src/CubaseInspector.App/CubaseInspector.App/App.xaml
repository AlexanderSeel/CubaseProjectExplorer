<Application x:Class="CubaseInspector.App.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <MaterialToolkitTheme xmlns="using:Uno.Toolkit.UI.Material"
                              ColorOverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Match the Material presenter and container heights; setting only the
           item's Height clips the compact navigation icons. -->
      <x:Double x:Key="MaterialNavigationItemHeight">44</x:Double>
      <x:Double x:Key="MaterialMUXNavigationViewItemOnLeftMinHeight">44</x:Double>
      <x:Double x:Key="NavigationViewItemOnLeftMinHeight">44</x:Double>
      <x:Double x:Key="MaterialNavigationItemMarginCompact">6</x:Double>
      <SolidColorBrush x:Key="InspectorSurfaceBrush" Color="{ThemeResource SurfaceColor}" />
      <SolidColorBrush x:Key="InspectorAccentBrush" Color="{ThemeResource PrimaryColor}" />
      <SolidColorBrush x:Key="InspectorTextSecondaryBrush" Color="{ThemeResource OnSurfaceVariantColor}" />
      <SolidColorBrush x:Key="InspectorDividerBrush" Color="{ThemeResource OutlineVariantColor}" />
      <SolidColorBrush x:Key="InspectorNoticeBrush" Color="{ThemeResource PrimaryContainerColor}" />

      <Style x:Key="InspectorPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadlineMedium}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="InspectorSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="InspectorBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
        <Setter Property="FontSize" Value="13" />
      </Style>
      <Style x:Key="InspectorMetadataTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
      </Style>
      <Style x:Key="InspectorCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlinedButtonStyle}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,1,0,1" />
      </Style>
      <Style x:Key="InspectorPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource FilledButtonStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style x:Key="InspectorSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource FilledTonalButtonStyle}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,1,0,1" />
      </Style>
      <Style x:Key="InspectorIconButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style x:Key="InspectorFilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource OutlinedTextBoxStyle}">
        <Setter Property="Height" Value="40" />
        <!-- Material's inner presenters are 40px high before outer padding. -->
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style x:Key="InspectorFilterComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
