<Application x:Class="CubaseInspector.App.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!-- Load Uno.UI.Toolkit resources -->
        <ToolkitResources xmlns="using:Uno.Toolkit.UI" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="InspectorSurfaceBrush" Color="#FF23272D" />
      <SolidColorBrush x:Key="InspectorAccentBrush" Color="#FF4191F5" />
      <SolidColorBrush x:Key="InspectorTextSecondaryBrush" Color="#FFB4BCC7" />
      <SolidColorBrush x:Key="InspectorDividerBrush" Color="#FF373D45" />
      <SolidColorBrush x:Key="InspectorNoticeBrush" Color="#FF203043" />

      <Style x:Key="InspectorPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="InspectorSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="InspectorBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
      </Style>
      <Style x:Key="InspectorMetadataTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource InspectorTextSecondaryBrush}" />
      </Style>
      <Style x:Key="InspectorCommandButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="0,2,0,2" />
      </Style>
      <Style x:Key="InspectorFilterTextBoxStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
      </Style>
      <Style x:Key="InspectorFilterComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>

</Application>
