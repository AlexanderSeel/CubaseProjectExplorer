<Page x:Class="CubaseInspector.App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Page.Resources>
    <DataTemplate x:Key="ProjectChangeTemplate">
      <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12,10" Margin="0,3" CornerRadius="4">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.2*" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Entity}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Property}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding BeforeText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Text="{Binding AfterText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding ChangeLabel}" FontSize="11" />
            <TextBlock Text="{Binding MatchQuality}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ScanIssueTemplate">
      <StackPanel Padding="10,7" Spacing="3">
        <TextBlock Text="{Binding Name} · {Binding Code}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding Path}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="54" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="20,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
        <FontIcon Glyph="&#xE8B7;" FontSize="18" />
        <TextBlock Text="CUBASE PROJECT EXPLORER" FontSize="14" FontWeight="SemiBold" />
        <Border Width="1" Height="22" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="6,0" />
        <TextBlock Text="Read-only project analysis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="OpenProjectButton" Content="Open project" Click="OpenProject_Click" />
        <Button x:Name="ScanFolderButton" Content="Scan folder" Click="ScanFolder_Click" />
      </StackPanel>
    </Grid>
    <Grid x:Name="ScanProgressPanel" Grid.Row="1" Visibility="Collapsed" Padding="16,5"
          Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="3">
        <TextBlock x:Name="ScanProgressLabel" FontSize="11" TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
        <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Height="5"
                     HorizontalAlignment="Stretch" />
      </StackPanel>
      <Button x:Name="CancelScanButton" Grid.Column="1" Content="Cancel scan" Margin="12,0,0,0"
              VerticalAlignment="Center" Click="CancelScan_Click"
              AutomationProperties.Name="Cancel folder scan" />
    </Grid>
    <Grid Grid.Row="2" Padding="12,0" ColumnSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Width="32" Height="30" Padding="0"
              ToolTipService.ToolTip="Back" AutomationProperties.Name="Back" Click="Back_Click" />
      <Button x:Name="ForwardButton" Grid.Column="1" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Width="32" Height="30" Padding="0"
              ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward" Click="Forward_Click" />
      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
        <StackPanel x:Name="BreadcrumbHost" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" />
      </ScrollViewer>
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" x:Name="BusyIndicatorPanel" Visibility="Collapsed">
        <ProgressRing x:Name="BusySpinner" Width="18" Height="18" IsActive="False" AutomationProperties.Name="Background task in progress" />
        <TextBlock x:Name="BusyText" FontSize="11" MaxWidth="260" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="3" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" PaneDisplayMode="Left" IsPaneToggleButtonVisible="True"
                    SelectionChanged="Navigation_SelectionChanged" CompactModeThresholdWidth="700"
                    ExpandedModeThresholdWidth="1100" OpenPaneLength="240" CompactPaneLength="54">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Project Library" Tag="Projects" Icon="Home" />
        <NavigationViewItem Content="Search everything" Tag="Search" Icon="Find" />
        <NavigationViewItem Content="Project Calendar" Tag="Calendar" Icon="Calendar" />
        <NavigationViewItem Content="Overview" Tag="Overview" Icon="View" />
        <NavigationViewItem Content="Tracks &amp; Channels" Tag="Tracks" Icon="List" />
        <NavigationViewItem Content="Plug-ins" Tag="Plugins" Icon="Library" />
        <NavigationViewItem Content="Routing" Tag="Routing" Icon="Rotate" />
        <NavigationViewItem Content="Audio / MIDI I/O" Tag="IO" Icon="Microphone" />
        <NavigationViewItem Content="Sample finder" Tag="Samples" Icon="Find" />
        <NavigationViewItem Content="MIDI tracks" Tag="Midi" Icon="MusicInfo" />
        <NavigationViewItem Content="Statistics" Tag="Statistics" Icon="AllApps" />
        <NavigationViewItemSeparator />
        <NavigationViewItem Content="Compare projects" Tag="Compare" Icon="Switch" />
        <NavigationViewItem Content="Local plug-in inventory" Tag="Inventory" Icon="Find" />
        <NavigationViewItem Content="Plug-in catalog" Tag="Catalog" Icon="Shop" />
        <NavigationViewItem Content="Dependency preflight" Tag="Preflight" Icon="AllApps" />
        <NavigationViewItem Content="Reports &amp; tools" Tag="Tools" Icon="Save" />
        <NavigationViewItem Content="Library database" Tag="Database" Icon="Folder" />
        <NavigationViewItemSeparator />
        <NavigationViewItem Content="Settings" Tag="Settings" Icon="Setting" />
      </NavigationView.MenuItems>
      <Grid x:Name="PageHost" Padding="24,20" />
    </NavigationView>
    <Grid Grid.Row="4" Padding="12,0" Background="{ThemeResource LayerFillColorDefaultBrush}">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="24" Padding="0"
              Background="Transparent" BorderThickness="0" AutomationProperties.Name="Evidence and limitations"
              ToolTipService.ToolTip="Evidence and limitations" Click="Evidence_Click">
        <FontIcon Glyph="&#xE946;" FontSize="14" />
      </Button>
    </Grid>
  </Grid>
</Page>
