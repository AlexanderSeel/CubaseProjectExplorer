<Page x:Class="CubaseInspector.App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource BackgroundBrush}">
  <Page.Resources>
    <DataTemplate x:Key="ProjectChangeTemplate">
      <Border Background="{ThemeResource SurfaceBrush}" Padding="12,10" Margin="0,3" CornerRadius="4">
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="1.2*" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding Entity}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Property}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding BeforeText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Text="{Binding AfterText}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding ChangeLabel}" FontSize="11" />
            <TextBlock Text="{Binding MatchQuality}" FontSize="10" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ScanIssueTemplate">
      <StackPanel Padding="10,7" Spacing="3">
        <TextBlock Text="{Binding Name} · {Binding Code}" FontSize="12" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
        <TextBlock Text="{Binding Path}" FontSize="10" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52" />
      <RowDefinition Height="32" />
      <RowDefinition Height="*" />
      <RowDefinition Height="28" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Padding="16,0" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="14">
        <Border Width="30" Height="30" CornerRadius="8" Background="{ThemeResource PrimaryContainerBrush}">
          <FontIcon Glyph="&#xE8D6;" FontSize="18" Foreground="{ThemeResource OnPrimaryContainerBrush}" />
        </Border>
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="Project Explorer" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          <TextBlock x:Name="SessionContextText" Text="Your project library" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="480" Foreground="{ThemeResource OnSurfaceBrush}" />
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="{ThemeResource SecondaryContainerBrush}" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
        <TextBlock Text="LOCAL · READ ONLY" FontSize="10" CharacterSpacing="70" Foreground="{ThemeResource OnSecondaryContainerBrush}" />
      </Border>
    </Grid>
    <Grid Grid.Row="1" Padding="12,0" ColumnSpacing="8" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Width="32" Height="30" Padding="0"
              Style="{StaticResource InspectorIconButtonStyle}"
              ToolTipService.ToolTip="Back" AutomationProperties.Name="Back" Click="Back_Click" />
      <Button x:Name="ForwardButton" Grid.Column="1" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Width="32" Height="30" Padding="0"
              Style="{StaticResource InspectorIconButtonStyle}"
              ToolTipService.ToolTip="Forward" AutomationProperties.Name="Forward" Click="Forward_Click" />
      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
        <StackPanel x:Name="BreadcrumbHost" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" />
      </ScrollViewer>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="2" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" PaneDisplayMode="Auto" IsPaneToggleButtonVisible="True"
                    SelectionChanged="Navigation_SelectionChanged" CompactModeThresholdWidth="700"
                    ExpandedModeThresholdWidth="1200" OpenPaneLength="196" CompactPaneLength="80">
      <NavigationView.MenuItems>
        <NavigationViewItemHeader Content="YOUR LIBRARY" />
        <NavigationViewItem MinHeight="40" Content="Studio home" Tag="Home" Icon="Home" />
        <NavigationViewItem MinHeight="40" Content="Projects" Tag="Projects" Icon="Folder" />
        <NavigationViewItemHeader Content="IN THIS SESSION" />
        <NavigationViewItem MinHeight="40" Content="Session overview" Tag="Overview" Icon="View" />
        <NavigationViewItem MinHeight="40" Content="Tracks" Tag="Tracks" Icon="List" />
        <NavigationViewItem MinHeight="40" Content="Plug-ins" Tag="Plugins" Icon="Library" />
        <NavigationViewItem MinHeight="40" Content="Routing" Tag="Routing" Icon="Rotate" />
        <NavigationViewItem MinHeight="40" Content="Audio &amp; MIDI I/O" Tag="IO" Icon="Microphone" />
        <NavigationViewItem MinHeight="40" Content="Audio" Tag="Samples" Icon="Find" />
        <NavigationViewItem MinHeight="40" Content="MIDI" Tag="Midi" Icon="MusicInfo" />
        <NavigationViewItemSeparator />
        <NavigationViewItem MinHeight="40" Content="Studio tools" Tag="StudioTools" Icon="AllApps" />
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem MinHeight="40" Content="Help" Tag="Help" Icon="Help" />
        <NavigationViewItem MinHeight="40" Content="Settings" Tag="Settings" Icon="Setting" />
      </NavigationView.FooterMenuItems>
      <Grid x:Name="PageHost" Padding="20,16" Background="{ThemeResource BackgroundBrush}" />
    </NavigationView>
    <Grid Grid.Row="3" Padding="12,0" Background="{ThemeResource SurfaceBrush}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" MaxWidth="420"
                 HorizontalAlignment="Left"
                 TextTrimming="CharacterEllipsis" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                  x:Name="BusyIndicatorPanel" Visibility="Collapsed">
        <ProgressRing x:Name="BusySpinner" Width="16" Height="16" IsActive="False" AutomationProperties.Name="Background task in progress" />
        <TextBlock x:Name="BusyText" FontSize="11" MaxWidth="360" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar x:Name="ActivityProgressBar" Width="132" Height="5" Minimum="0" Maximum="100"
                     VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Background task progress" />
        <TextBlock x:Name="ActivityPercentText" FontSize="11" MinWidth="36" TextAlignment="Right"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
        <Button x:Name="ActivityCancelButton" Content="Cancel" Padding="8,2" MinHeight="24"
                VerticalAlignment="Center" Visibility="Collapsed" Click="ActivityCancel_Click" />
      </StackPanel>
      <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="24" Padding="0"
              Background="Transparent" BorderThickness="0" AutomationProperties.Name="Help and reader FAQ"
              ToolTipService.ToolTip="Help and reader FAQ" Click="Evidence_Click">
        <FontIcon Glyph="&#xE946;" FontSize="14" />
      </Button>
    </Grid>
  </Grid>
</Page>
