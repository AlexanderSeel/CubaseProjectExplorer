<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#2563EB</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#E8EFFC</Color>
      <Color x:Key="OnPrimaryContainerColor">#163E80</Color>
      <Color x:Key="SecondaryColor">#596579</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#E8EDF3</Color>
      <Color x:Key="OnSecondaryContainerColor">#243244</Color>
      <Color x:Key="TertiaryColor">#60728C</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#E5ECF5</Color>
      <Color x:Key="OnTertiaryContainerColor">#243244</Color>
      <Color x:Key="BackgroundColor">#F5F7FA</Color>
      <Color x:Key="OnBackgroundColor">#1D2633</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#1D2633</Color>
      <Color x:Key="SurfaceVariantColor">#EDF1F5</Color>
      <Color x:Key="OnSurfaceVariantColor">#626D7C</Color>
      <Color x:Key="OutlineColor">#A3ADBA</Color>
      <Color x:Key="OutlineVariantColor">#D8DFE7</Color>
      <Color x:Key="SurfaceTintColor">#2563EB</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#7CA9F2</Color>
      <Color x:Key="OnPrimaryColor">#102A4D</Color>
      <Color x:Key="PrimaryContainerColor">#233C61</Color>
      <Color x:Key="OnPrimaryContainerColor">#DDEBFF</Color>
      <Color x:Key="SecondaryColor">#A8B8CE</Color>
      <Color x:Key="OnSecondaryColor">#233044</Color>
      <Color x:Key="SecondaryContainerColor">#2A3545</Color>
      <Color x:Key="OnSecondaryContainerColor">#DFE6F0</Color>
      <Color x:Key="TertiaryColor">#9BADCA</Color>
      <Color x:Key="OnTertiaryColor">#213045</Color>
      <Color x:Key="TertiaryContainerColor">#303E56</Color>
      <Color x:Key="OnTertiaryContainerColor">#DEE7F5</Color>
      <Color x:Key="BackgroundColor">#101419</Color>
      <Color x:Key="OnBackgroundColor">#E8EDF4</Color>
      <Color x:Key="SurfaceColor">#191F27</Color>
      <Color x:Key="OnSurfaceColor">#E8EDF4</Color>
      <Color x:Key="SurfaceVariantColor">#222A35</Color>
      <Color x:Key="OnSurfaceVariantColor">#9DA9BA</Color>
      <Color x:Key="OutlineColor">#596579</Color>
      <Color x:Key="OutlineVariantColor">#303B49</Color>
      <Color x:Key="SurfaceTintColor">#7CA9F2</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
